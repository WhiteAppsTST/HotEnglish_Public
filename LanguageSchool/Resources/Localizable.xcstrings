    "home.ai_disclosure.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses third-party AI services (OpenAI) to generate teacher replies, evaluate your practice, and produce the teacher's voice. Messages you send during lessons and free chat are sent to these providers for processing according to their terms. We do not control or take responsibility for how third-party AI providers process this data.\n\nBy continuing to use the app, you confirm your agreement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app usa servicios de IA de terceros (OpenAI) para generar las respuestas del profesor, evaluar tu práctica y producir la voz del profesor. Los mensajes que envías durante las lecciones y el chat libre se envían a estos proveedores para su procesamiento según sus condiciones. No controlamos ni asumimos responsabilidad por la forma en que los proveedores externos de IA procesan estos datos.\n\nAl continuar usando la app, confirmas tu aceptación."
          }
        }
      }
    },
